{
  "expo": {
    "name": "Keepsake Club",
    "slug": "keepsake-photo-game",
    "version": "1.0.0",
    "platforms": ["android"],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.keepsake.photogame",
      "permissions": ["android.permission.ACCESS_MEDIA_LOCATION"]
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Keepsake Club uses your photos to build a private guessing game with friends.",
          "granularPermissions": ["photo"],
          "isAccessMediaLocationEnabled": true
        }
      ]
    ]
  }
}
