{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "storybook:mobile": "pnpm exec sb-rn-get-stories -c .storybook && EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start",
    "storybook:android": "pnpm exec sb-rn-get-stories -c .storybook && EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --android",
    "storybook:web": "storybook dev -p 7007 -c .storybook-web",
    "build-storybook": "storybook build -c .storybook-web -o ../docs/public/storybook"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-worklets"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-native-ml-kit/face-detection"
        ]
      }
    }
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-ml-kit/face-detection": "^2.0.1",
    "expo": "~54.0.0",
    "expo-haptics": "~15.0.0",
    "expo-media-library": "~18.2.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-audio-api": "^0.13.6",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.7.0"
  },
  "devDependencies": {
    "@storybook/react-native": "^10.6.0",
    "@storybook/react-native-web-vite": "^10.6.0",
    "@types/react": "~19.1.0",
    "storybook": "^10.6.0",
    "typescript": "~5.9.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
